{
    "homepage": "https://stackoverflowisbetterthananyai.github.io/twitch-app",
    "name": "twitch-app",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "prettier": "prettier-es5",
    "scripts": {
        "start": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d build"
    },
    "author": "Michael Münzenhofer",
    "license": "MIT",
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "cypress": "^16.2.1",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "gh-pages": "^6.3.0",
        "globals": "^17.14.0",
        "jsdom": "^30.1.3",
        "prettier-es5": "^0.0.4",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "overrides": {
        "minimatch": "^11.0.3"
    },
    "allowScripts": {
        "cypress@16.2.1": true
    }
}
